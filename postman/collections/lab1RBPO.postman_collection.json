  "item": [
    {
      "name": "1. Сценарий: от данных до операций",
      "item": [
        {
          "name": "Статус сервиса (без авторизации)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/status",
            "description": "Публичный эндпоинт, аутентификация не требуется.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Сервис доступен\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Статус приложения в ответе\", () => pm.expect(pm.response.json()).to.have.property(\"status\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать зал А (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/halls",
            "description": "Создание зала доступно только роли ADMIN.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{adminUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Зал Экспедиций {{runId}}\",\n  \"area\": 60.00,\n  \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Зал создан\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"hallAId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать зал Б (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/halls",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{adminUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Зал Малый {{runId}}\",\n  \"area\": 40.00,\n  \"isAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Зал создан\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"hallBId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать экспонат (CURATOR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/exhibits",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inventoryNumber\": \"INV-{{runId}}\",\n  \"name\": \"Каменный идол {{runId}}\",\n  \"condition\": \"GOOD\",\n  \"requiredArea\": 4.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Экспонат создан\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"exhibitId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Создать выставку (CURATOR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/exhibitions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Северные древности {{runId}}\",\n  \"startDate\": \"{{startDate}}\",\n  \"endDate\": \"{{endDate}}\",\n  \"status\": \"PLANNED\",\n  \"curatorId\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Выставка создана\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"exhibitionId\", pm.response.json().id);",
                  "pm.test(\"Статус PLANNED\", () => pm.expect(pm.response.json().status).to.eql(\"PLANNED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Бизнес-операция 1: разместить экспонат в зале А",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/business/placements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exhibitionId\": {{exhibitionId}},\n  \"exhibitId\": {{exhibitId}},\n  \"hallId\": {{hallAId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Экспонат размещён\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Размещение запланировано\", () => pm.expect(pm.response.json().status).to.eql(\"PLANNED\"));",
                  "pm.collectionVariables.set(\"placementId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Бизнес-операция 2: переместить экспонат в зал Б",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/business/placements/{{placementId}}/move",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hallId\": {{hallBId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Экспонат перемещён\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Экспонат в новом зале\", () => pm.expect(pm.response.json().hall.id).to.eql(Number(pm.collectionVariables.get(\"hallBId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Бизнес-операция 3: открыть выставку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/business/exhibitions/{{exhibitionId}}/open"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Выставка открыта\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Статус ACTIVE\", () => pm.expect(pm.response.json().status).to.eql(\"ACTIVE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Проверить состояние выставки после открытия",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/exhibitions/{{exhibitionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Выставка доступна\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Статус ACTIVE\", () => pm.expect(pm.response.json().status).to.eql(\"ACTIVE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Негативный сценарий: реставрация при активной выставке",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/business/exhibits/{{exhibitId}}/restoration",
            "description": "Экспонат участвует в активной выставке — бизнес-правило возвращает 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Операция запрещена\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Бизнес-операция 4: закрыть выставку",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/business/exhibitions/{{exhibitionId}}/close"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Выставка закрыта\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Статус COMPLETED\", () => pm.expect(pm.response.json().status).to.eql(\"COMPLETED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Бизнес-операция 5: отправить экспонат на реставрацию",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/business/exhibits/{{exhibitId}}/restoration"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Экспонат отправлен\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Состояние RESTORATION\", () => pm.expect(pm.response.json().condition).to.eql(\"RESTORATION\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Проверить изменения состояния экспоната",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/exhibits/{{exhibitId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Экспонат доступен\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Состояние RESTORATION\", () => pm.expect(pm.response.json().condition).to.eql(\"RESTORATION\"));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Создаём залы, экспонат и выставку, размещаем экспонат, перемещаем его, открываем и закрываем выставку, отправляем экспонат на реставрацию. Каждый шаг зависит от состояния, созданного предыдущими запросами."
    },
    {
      "name": "2. CRUD: пользователи (ADMIN)",
